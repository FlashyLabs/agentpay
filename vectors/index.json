{
  "contract": "pay-policy/1",
  "note": "The record of what every vector is expected to do. test/pay-policy.test.mjs drives from this file and fails if a vector on disk is not named here.",
  "policies": [
    { "file": "monthly-cap-valid.json", "expect": "valid" },
    { "file": "daily-cap-valid.json", "expect": "valid" },
    { "file": "weekly-jurisdiction-valid.json", "expect": "valid" },
    { "file": "closed-no-spend-valid.json", "expect": "valid" },
    { "file": "parent-valid.json", "expect": "valid" },
    { "file": "child-narrowed-valid.json", "expect": "valid" },
    { "file": "widened-cap-invalid.json", "expect": "valid", "note": "a valid policy on its own; an invalid attenuation of parent-valid.json" },
    { "file": "widened-allowlist-invalid.json", "expect": "valid", "note": "as above" },
    { "file": "widened-rails-invalid.json", "expect": "valid", "note": "as above" },
    { "file": "widened-period-cap-invalid.json", "expect": "valid", "note": "as above" },
    { "file": "widened-jurisdiction-invalid.json", "expect": "valid", "note": "as above" },
    { "file": "widened-human-gate-invalid.json", "expect": "valid", "note": "as above" },
    { "file": "dropped-period-cap-invalid.json", "expect": "valid", "note": "as above" },
    { "file": "period-mismatch-invalid.json", "expect": "valid", "note": "as above" },
    { "file": "parent-mismatch-invalid.json", "expect": "valid", "note": "as above" },
    { "file": "float-money-invalid.json", "expect": "invalid", "codes": ["FLOAT", "FLOAT_MONEY"] },
    { "file": "missing-currency-invalid.json", "expect": "invalid", "codes": ["MISSING_CURRENCY"] },
    { "file": "no-human-gate-invalid.json", "expect": "invalid", "codes": ["NO_HUMAN_GATE"] },
    { "file": "unknown-key-invalid.json", "expect": "invalid", "codes": ["UNKNOWN_KEY"] },
    { "file": "bad-period-invalid.json", "expect": "invalid", "codes": ["BAD_PERIOD"] },
    { "file": "human-gate-unreachable-invalid.json", "expect": "invalid", "codes": ["HUMAN_GATE_UNREACHABLE"] },
    { "file": "negative-money-invalid.json", "expect": "invalid", "codes": ["NEGATIVE_MONEY"] },
    { "file": "string-money-invalid.json", "expect": "invalid", "codes": ["NOT_INTEGER"] },
    { "file": "currency-mismatch-invalid.json", "expect": "invalid", "codes": ["CURRENCY_MISMATCH"] },
    { "file": "wrong-contract-invalid.json", "expect": "invalid", "codes": ["CONTRACT"] }
  ],
  "attenuations": [
    { "parent": "parent-valid.json", "child": "child-narrowed-valid.json", "expect": "valid" },
    { "parent": "parent-valid.json", "child": "widened-cap-invalid.json", "expect": "invalid", "codes": ["WIDENED_PER_TRANSACTION"] },
    { "parent": "parent-valid.json", "child": "widened-allowlist-invalid.json", "expect": "invalid", "codes": ["WIDENED_COUNTERPARTIES"] },
    { "parent": "parent-valid.json", "child": "widened-rails-invalid.json", "expect": "invalid", "codes": ["WIDENED_RAILS"] },
    { "parent": "parent-valid.json", "child": "widened-period-cap-invalid.json", "expect": "invalid", "codes": ["WIDENED_PERIOD_CAP"] },
    { "parent": "parent-valid.json", "child": "widened-jurisdiction-invalid.json", "expect": "invalid", "codes": ["WIDENED_JURISDICTIONS"] },
    { "parent": "parent-valid.json", "child": "widened-human-gate-invalid.json", "expect": "invalid", "codes": ["WIDENED_HUMAN_GATE"] },
    { "parent": "parent-valid.json", "child": "dropped-period-cap-invalid.json", "expect": "invalid", "codes": ["DROPPED_PERIOD_CAP"] },
    { "parent": "parent-valid.json", "child": "period-mismatch-invalid.json", "expect": "invalid", "codes": ["PERIOD_MISMATCH"] },
    { "parent": "parent-valid.json", "child": "parent-mismatch-invalid.json", "expect": "invalid", "codes": ["PARENT_MISMATCH"] },
    { "parent": "parent-valid.json", "child": "monthly-cap-valid.json", "expect": "invalid", "codes": ["PARENT_MISMATCH", "DROPPED_JURISDICTIONS"] },
    { "parent": "parent-valid.json", "child": "float-money-invalid.json", "expect": "invalid", "codes": ["CHILD_FLOAT_MONEY"] }
  ],
  "scenarios": [
    { "name": "allow within cap", "policy": "monthly-cap-valid.json", "payment": "payments/within-cap.json", "ledger": "ledgers/month-100000.json", "expect": { "decision": "allow", "codes": [] } },
    { "name": "deny over per-transaction cap", "policy": "monthly-cap-valid.json", "payment": "payments/over-per-tx.json", "ledger": "ledgers/month-100000.json", "expect": { "decision": "deny", "codes": ["PER_TX_CAP"] } },
    { "name": "deny counterparty not allowlisted", "policy": "monthly-cap-valid.json", "payment": "payments/unlisted-counterparty.json", "ledger": "ledgers/month-100000.json", "expect": { "decision": "deny", "codes": ["COUNTERPARTY_NOT_PERMITTED"] } },
    { "name": "escalate above human threshold", "policy": "monthly-cap-valid.json", "payment": "payments/above-human-gate.json", "ledger": "ledgers/month-100000.json", "expect": { "decision": "escalate", "codes": ["HUMAN_APPROVAL_REQUIRED"] } },
    { "name": "deny period cap exhausted via ledgerState", "policy": "monthly-cap-valid.json", "payment": "payments/within-cap.json", "ledger": "ledgers/month-498000.json", "expect": { "decision": "deny", "codes": ["PERIOD_CAP"] } },
    { "name": "deny rail not permitted", "policy": "monthly-cap-valid.json", "payment": "payments/unlisted-rail.json", "ledger": "ledgers/month-100000.json", "expect": { "decision": "deny", "codes": ["RAIL_NOT_PERMITTED"] } },
    { "name": "deny currency mismatch", "policy": "monthly-cap-valid.json", "payment": "payments/eur.json", "ledger": "ledgers/month-100000.json", "expect": { "decision": "deny", "codes": ["CURRENCY_MISMATCH"] } },
    { "name": "deny when ledgerState is missing and the policy has a period cap", "policy": "monthly-cap-valid.json", "payment": "payments/within-cap.json", "ledger": null, "expect": { "decision": "deny", "codes": ["LEDGER_STATE_MISSING"] } },
    { "name": "deny when ledgerState is for a different period", "policy": "monthly-cap-valid.json", "payment": "payments/within-cap.json", "ledger": "ledgers/day-usd-0.json", "expect": { "decision": "deny", "codes": ["LEDGER_STATE_MISMATCH"] } },
    { "name": "escalate everything when the gate is zero", "policy": "weekly-jurisdiction-valid.json", "payment": "payments/hotel-de.json", "ledger": "ledgers/week-eur-0.json", "expect": { "decision": "escalate", "codes": ["HUMAN_APPROVAL_REQUIRED"] } },
    { "name": "deny jurisdiction not permitted", "policy": "weekly-jurisdiction-valid.json", "payment": "payments/hotel-es.json", "ledger": "ledgers/week-eur-0.json", "expect": { "decision": "deny", "codes": ["JURISDICTION_NOT_PERMITTED"] } },
    { "name": "deny jurisdiction unknown when the policy restricts them", "policy": "weekly-jurisdiction-valid.json", "payment": "payments/hotel-no-jurisdiction.json", "ledger": "ledgers/week-eur-0.json", "expect": { "decision": "deny", "codes": ["JURISDICTION_UNKNOWN"] } },
    { "name": "deny everything against a closed policy", "policy": "closed-no-spend-valid.json", "payment": "payments/within-cap.json", "ledger": null, "expect": { "decision": "deny", "codes": ["RAIL_NOT_PERMITTED", "COUNTERPARTY_NOT_PERMITTED", "PER_TX_CAP"] } },
    { "name": "deny a zero amount", "policy": "monthly-cap-valid.json", "payment": "payments/zero.json", "ledger": "ledgers/month-100000.json", "expect": { "decision": "deny", "codes": ["INVALID_AMOUNT"] } },
    { "name": "deny a payment carrying a float", "policy": "monthly-cap-valid.json", "payment": "payments/float-invalid.json", "ledger": "ledgers/month-100000.json", "expect": { "decision": "deny", "codes": ["PAYMENT_INVALID"] } },
    { "name": "deny with every failing reason named", "policy": "monthly-cap-valid.json", "payment": "payments/over-cap-unlisted.json", "ledger": "ledgers/month-100000.json", "expect": { "decision": "deny", "codes": ["COUNTERPARTY_NOT_PERMITTED", "PER_TX_CAP"] } }
  ]
}
